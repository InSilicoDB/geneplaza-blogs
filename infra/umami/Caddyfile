# Automatic HTTPS via Let's Encrypt. Requires analytics.geneplaza.com -> this host.
analytics.geneplaza.com {
	encode gzip
	reverse_proxy umami:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# The tracker must be reachable from blog.geneplaza.com and geneplaza.com.
	@tracker path /gp.js /api/send
	header @tracker Access-Control-Allow-Origin "*"
}
